# ---- 虚拟环境与 Python 缓存（体积大、可重建） ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ---- 数据集与模型权重（体积大，脚本可重新下载/生成） ----
# VisDrone / DOTA：python scripts/prepare_data.py [--dataset dota]
# VisDrone-Sparse4K 受控实验画布：python scripts/sparsity_sweep.py --save
datasets/
*.pt
weights/*
# 例外：VisDrone 微调检测器（19MB）直接随仓库分发，clone 下来即可复现 visdrone_ft 实验
!weights/yolo11s-visdrone-ft.pt

# ---- 评测缓存（可由 run_eval.py cache 重新生成） ----
results/cache.pkl
results/*/cache.pkl
results/*/det_cache.pkl

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
Desktop.ini
~$*

# ---- 临时输出（脚本重定向的 stdout/stderr、Demo 运行日志） ----
_*.txt
results/*.log

# ---- 强基线逐图结果（strong_baselines.py run 生成，可重跑） ----
results/strong*.pkl
results/*/strong*.pkl

# ---- 微调训练输出（train_visdrone.py） ----
runs_ft/
